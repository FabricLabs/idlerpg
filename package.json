{
  "name": "idlerpg",
  "version": "0.3.0",
  "description": "Generalized implementation of IdleRPG, a game which rewards participants for remaining idle.",
  "main": "types/idlerpg.js",
  "exports": {
    ".": "./types/idlerpg.js",
    "./types/*": "./types/*.js",
    "./services/*": "./services/*.js",
    "./constants": "./constants.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "26.12.1",
    "npm": ">=12"
  },
  "scripts": {
    "coverage": "c8 npm test",
    "docs": "npm run make:docs && http-server docs -p 8000",
    "link:fabric": "node -e \"const fs=require('fs'),path=require('path');const target=process.env.FABRIC_CORE||path.resolve(__dirname,'../fabric-clean');const dest=path.join('node_modules','@fabric','core');fs.mkdirSync(path.dirname(dest),{recursive:true});fs.rmSync(dest,{recursive:true,force:true});fs.symlinkSync(target,dest,'dir');console.log('linked @fabric/core ->',target)\"",
    "link:rpg": "node -e \"const fs=require('fs'),path=require('path');const target=process.env.FABRIC_RPG||path.resolve(__dirname,'../rpg');const dest=path.join('node_modules','@fabric','rpg');fs.mkdirSync(path.dirname(dest),{recursive:true});fs.rmSync(dest,{recursive:true,force:true});fs.symlinkSync(target,dest,'dir');console.log('linked @fabric/rpg ->',target)\"",
    "make:docs": "jsdoc types README.md -c jsdoc.json -d docs",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "review:coverage": "c8 --reporter=lcov npm test && http-server coverage/lcov-report -p 8000",
    "simulate": "node scripts/simulate.js",
    "start": "node scripts/idlerpg.js",
    "test": "mocha tests --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/idlerpg.git"
  },
  "keywords": [
    "idlerpg",
    "fabric",
    "idle",
    "rpg",
    "game"
  ],
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/idlerpg/issues"
  },
  "homepage": "https://github.com/FabricLabs/idlerpg#readme",
  "dependencies": {
    "@fabric/core": "FabricLabs/fabric#features/passport",
    "@fabric/rpg": "FabricLabs/rpg#feature/passport"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "http-server": "14.1.1",
    "jsdoc": "4.0.5",
    "mocha": "12.0.3"
  }
}
